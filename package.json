{
  "name": "inventory-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "make-exe": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.shine.businessos",
    "productName": "BusinessOS POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      "prisma/dev.db"
    ],
    "asarUnpack": [
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "googleapis": "^186.0.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.58.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}

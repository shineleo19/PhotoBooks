datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  category  String   @default("General")
  price     Float
  baseUnit  String   @default("Pieces")
  stock     Int
  minStock  Int      @default(5)
  isPackage Boolean  @default(false)
  createdAt DateTime @default(now())
  finishedMaterials ItemMaterial[] @relation("FinishedItem")
  materialFor ItemMaterial[] @relation("MaterialItem")
}

model ItemMaterial {
  id              String @id @default(uuid())
  finishedItemId  String
  materialItemId  String
  quantity        Float  @default(1)
  finishedItem    Item   @relation("FinishedItem", fields: [finishedItemId], references: [id], onDelete: Cascade)
  materialItem    Item   @relation("MaterialItem", fields: [materialItemId], references: [id], onDelete: Restrict)
}

model Sale {
  id            String   @id @default(uuid())
  invoiceNo     String   @unique
  customerName  String   @default("Walk-in")
  customerPhone String
  total         Float
  cgst          Float
  sgst          Float
  synced        Boolean  @default(false)
  createdAt     DateTime @default(now())
}